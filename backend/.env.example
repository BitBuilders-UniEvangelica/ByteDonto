# ============================================================
# ByteDonto — backend único (Flask). O MESMO código roda local e em produção;
# só muda este arquivo. Copie para .env (NUNCA versione o .env).
# A API NÃO inicia se a configuração do modo estiver ausente, insegura ou
# misturar ambientes (config.validar_config).
# ============================================================

# --- Ambiente e modo de dados --------------------------------
# APP_ENV: development | test | staging | homologacao | production
#   No Railway, se ficar vazio, é tratado como production.
APP_ENV=development
# DATA_BACKEND:
#   local    -> PostgreSQL local + auth local (JWT) + arquivos em disco
#   supabase -> Supabase Auth + Database + Storage (produção/homologação)
# Fora de produção é OBRIGATÓRIO. Em produção, vazio = supabase.
# Travas: production + local = erro; supabase exige APP_ENV production/staging/homologacao.
DATA_BACKEND=local
FLASK_DEBUG=False
# Porta do `python run.py` (o proxy do Vite usa 8001 por padrão). O Railway define a sua.
PORT=8001

# --- Comum (OBRIGATÓRIA nos dois modos) ----------------------
# Mínimo de 32 caracteres aleatórios. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- CORS ----------------------------------------------------
# Origens do frontend separadas por vírgula. Em produção, informe a URL real.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# MODO local (DATA_BACKEND=local)
# ============================================================
# Só PostgreSQL da própria máquina (localhost/127.0.0.1/socket). Qualquer host
# de Supabase/Railway/nuvem é recusado. Crie o banco com: venv/bin/python init_db.py
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/bytedonto_dev
# Hosts extras aceitos (ex.: nome do container do Postgres no docker compose).
LOCAL_DB_ALLOWED_HOSTS=
# Assina os tokens da auth local e os links do storage local. Mínimo 32 caracteres.
JWT_SECRET=
# Validade do token em segundos (3600 = 1h, igual ao Supabase)
JWT_EXPIRES_SECONDS=3600
# Pasta dos arquivos/imagens dos pacientes (padrão: backend/storage)
STORAGE_DIR=
PUBLIC_API_URL=http://localhost:8001

# ============================================================
# MODO supabase (DATA_BACKEND=supabase) — produção / homologação
# ============================================================
# Settings > API do projeto. Use https:// (http só para Supabase local em localhost).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# service_role key — dá acesso total ao banco. Só no backend, nunca no frontend.
SUPABASE_KEY=
# anon (public) key — usada no login. Precisa ser DIFERENTE da service_role.
SUPABASE_ANON_KEY=

# --- Rate limiting (opcional) --------------------------------
# Padrão: memory:// (1 worker). Com vários workers use Redis: redis://HOST:6379
RATELIMIT_STORAGE_URI=memory://

# --- Integrações (opcionais, Fase 3) -------------------------
OPENAI_API_KEY=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=byedonto

# --- Seed de demonstração (SÓ modo local) --------------------
# seed_demo.py só roda com APP_ENV=development (ou local) e nunca no Railway.
# Use e-mails de teste (ex.: domínio example.com) — nunca e-mails pessoais.
# Senhas: mínimo de 12 caracteres. Contas que já existem NÃO têm a senha alterada.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NOME=Proprietário Demo
SEED_RECEPCAO_EMAIL=
SEED_RECEPCAO_PASSWORD=
SEED_ESPECIALISTA_EMAIL=
SEED_ESPECIALISTA_PASSWORD=
