# ============================================================
# backend — PRODUÇÃO (Supabase). Copie para .env e preencha.
# A API não sobe se faltar alguma variável marcada como obrigatória.
# Nunca coloque este arquivo preenchido no git.
# ============================================================

# Supabase (obrigatórias) — Painel do Supabase › Project Settings › API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_KEY=chave-service-role
SUPABASE_ANON_KEY=chave-anon
DATABASE_URL=

# Flask
SECRET_KEY=
# Ativa o modo debug do Flask (use "False" em produção)
FLASK_DEBUG=False
# Origens permitidas para CORS (separadas por vírgula)
ALLOWED_ORIGINS=https://seu-frontend.exemplo.com

# OpenAI / Evolution API (Fase 3) — opcionais
OPENAI_API_KEY=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=byedonto
