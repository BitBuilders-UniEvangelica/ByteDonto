VITE_SUPABASE_URL=https://xyzxyz.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key
# Em dev, deixe vazio para usar o proxy do Vite (permite acessar pelo celular com --host).
# Em produção, coloque a URL completa do backend.
VITE_API_URL=
# Backend para onde o Vite repassa /api em dev (8000 -> supabase, 8001 -> local)
API_PROXY_TARGET=http://localhost:8001
