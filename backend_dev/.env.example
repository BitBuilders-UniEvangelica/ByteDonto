# ============================================================
# backend_dev — ambiente de DESENVOLVIMENTO (PostgreSQL local)
# Copie para .env e ajuste. NUNCA coloque credenciais do Supabase aqui.
# ============================================================

# Conexão com o PostgreSQL local: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
# O banco é criado automaticamente pelo init_db.py.
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/bytedonto_dev

# Flask
SECRET_KEY=troque-por-uma-chave-aleatoria
FLASK_DEBUG=True
PORT=8001
# Origens permitidas para CORS (separadas por vírgula) — o Vite roda em 5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth local (JWT). Se vazio, usa SECRET_KEY.
JWT_SECRET=
# Validade do token em segundos (3600 = 1h, igual ao Supabase)
JWT_EXPIRES_SECONDS=3600

# Pasta onde os arquivos/imagens dos pacientes são salvos (padrão: backend_dev/storage)
STORAGE_DIR=
PUBLIC_API_URL=http://localhost:8001

# OpenAI / Evolution API (Fase 3) — opcionais
OPENAI_API_KEY=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=byedonto
